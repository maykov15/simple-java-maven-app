pipeline {
    agent any
    
    // 1. ADD THIS TOOLS BLOCK
    tools {
        jdk 'jdk21'      // Must match your exact name in Manage Jenkins -> Tools
        maven 'maven3'   // Must match your exact name in Manage Jenkins -> Tools
    }
    
    environment {
        // 1. Point to SonarCloud's official cloud URL
        SONARQUBE_URL = "https://sonarcloud.io"
        
        // 2. Add your unique SonarCloud Organization Key
        SONAR_ORGANIZATION = "maykov15"
        
        // Keep your other configs
        NEXUS_URL = "http://52.90.103.249:8081"
        NEXUS_CREDENTIAL_ID = "nexus-credentials"
    }
    
    options {
        skipStagesAfterUnstable()
    }
    
    stages {
       
        stage('Build') {
            steps {
                sh 'mvn -B -DskipTests clean package'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                // Ensure 'sonarqube-token' contains your SonarCloud User Token
                withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        mvn sonar:sonar \
                        -Dsonar.host.url=${SONARQUBE_URL} \
                        -Dsonar.token=${SONAR_TOKEN} \
                        -Dsonar.organization=${SONAR_ORGANIZATION} \
                        -Dsonar.projectKey=maykov15_simple-java-maven-app \
                        -Dsonar.projectName='Simple Java Maven App'
                    '''
                }
            }
        }

        
   stage('Upload to Nexus') {
            steps {
                sh '''
                    # Create Maven settings.xml with hardcoded Nexus credentials
                    cat > settings.xml <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<settings>
  <servers>
    <server>
      <id>nexus</id>
      <username>admin</username>
      <password>admin</password>
    </server>
  </servers>
</settings>
EOF
                    
                    # Deploy to Nexus
                    mvn deploy -DskipTests -s settings.xml \
                    -DaltDeploymentRepository=nexus::http://52.90.103.249:8081/repository/maven-snapshots/
                '''
            }
        }
        
        stage('Deliver') { 
            steps {
                sh './jenkins/scripts/deliver.sh' 
            }
        }
    }
}
